{
  "expo": {
    "name": "HBPlus Official Login",
    "slug": "hbplus-cross-platform-auth",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "hbplusauth",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#f7f8fc"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "fit.hbplus.auth"
    },
    "android": {
      "package": "fit.hbplus.auth"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      "expo-asset"
    ]
  }
}
